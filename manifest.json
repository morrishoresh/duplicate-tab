{
  "manifest_version": 2,
  "name": "Duplicate Tab",
  "version": "1.0.2",
  "description": "Duplicates the current tab with one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "duplicate-tab@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Duplicate tab"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}